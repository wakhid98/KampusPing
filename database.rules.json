{"rules":{
 ".read":false,".write":false,
 "admins":{"$uid":{".read":"auth != null && auth.uid === $uid"}},
 "audit":{".read":"auth != null && root.child('admins').child(auth.uid).exists()",
  "$id":{".write":"auth != null && root.child('admins').child(auth.uid).exists() && !data.exists()",
   ".validate":"newData.hasChildren(['t','by','a'])",
   "t":{".validate":"newData.isNumber()"},"by":{".validate":"newData.isString() && newData.val().length <= 100"},"a":{".validate":"newData.isString() && newData.val().length <= 200"},"$o":{".validate":false}}},
 "courses":{".read":"auth != null",
  "$id":{".write":"auth != null && root.child('admins').child(auth.uid).exists()",
   ".validate":"newData.hasChildren(['title','day','time'])",
   "title":{".validate":"newData.isString() && newData.val().length > 0 && newData.val().length <= 100"},
   "day":{".validate":"newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"},
   "time":{".validate":"newData.isString() && newData.val().matches(/^[0-2][0-9]:[0-5][0-9]$/)"},
   "room":{".validate":"newData.isString() && newData.val().length <= 60"},
   "lecturer":{".validate":"newData.isString() && newData.val().length <= 80"},
   "type":{".validate":"newData.val() === 'class'"},"$o":{".validate":false}}},
 "config":{".read":"auth != null",".write":"auth != null && root.child('admins').child(auth.uid).exists()",
  "announce":{"id":{".validate":"newData.isNumber()"},"text":{".validate":"newData.isString() && newData.val().length <= 500"},"$o":{".validate":false}},
  "quietStart":{".validate":"newData.isNumber() && newData.val() >= 0 && newData.val() <= 23"},
  "quietEnd":{".validate":"newData.isNumber() && newData.val() >= 0 && newData.val() <= 23"},"$o":{".validate":false}},
 "users":{".read":"auth != null && root.child('admins').child(auth.uid).exists()",".write":"auth != null && root.child('admins').child(auth.uid).exists()",
  "$uid":{".read":"auth != null && auth.uid === $uid",".write":"auth != null && auth.uid === $uid",
   "tgChatId":{".validate":"newData.isString() && newData.val().length <= 20 && newData.val().matches(/^-?[0-9]*$/)"},
   "streak":{".validate":"newData.isNumber()"},"best":{".validate":"newData.isNumber()"},
   "lastDone":{".validate":"newData.isString() && newData.val().length <= 10"},"lastNote":{".validate":"newData.isString() && newData.val().length <= 300"},
   "prefs":{"gateMin":{".validate":"newData.isNumber() && newData.val() >= 5 && newData.val() <= 25"},"$p":{".validate":"newData.isBoolean()"}},
   "focus":{"$d":{".validate":"newData.isNumber() && newData.val() >= 0 && newData.val() < 1000"}},
   "grades":{"$i":{".validate":"newData.hasChildren(['sks','nilai'])",
    "name":{".validate":"newData.isString() && newData.val().length <= 100"},"sks":{".validate":"newData.isNumber() && newData.val() >= 1 && newData.val() <= 6"},
    "nilai":{".validate":"newData.isString() && newData.val().matches(/^(A|B\\+|B|C\\+|C|D|E)$/)"},"$o":{".validate":false}}},
   "attend":{"$c":{"$d":{".validate":"newData.isString() && newData.val().matches(/^[hisa]$/) && $d.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"}}},
   "fcm":{"$t":{".validate":"newData.val() === true && $t.length < 300"}},
   "sent":{"$k":{".validate":"newData.isBoolean()"}},"annId":{".validate":"newData.isNumber()"},"$o":{".validate":false}}},
 "items":{".read":"auth != null && root.child('admins').child(auth.uid).exists()",".write":"auth != null && root.child('admins').child(auth.uid).exists()",
  "$uid":{".read":"auth != null && auth.uid === $uid",".write":"auth != null && auth.uid === $uid",
   "$id":{".validate":"newData.hasChildren(['type','title','done'])",
    "type":{".validate":"newData.val() === 'task' || newData.val() === 'scholar'"},
    "title":{".validate":"newData.isString() && newData.val().length > 0 && newData.val().length <= 120"},
    "course":{".validate":"newData.isString() && newData.val().length <= 80"},
    "when":{".validate":"newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$/)"},
    "weight":{".validate":"newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"},
    "step":{".validate":"newData.isString() && newData.val().length <= 200"},
    "link":{".validate":"newData.isString() && newData.val().length <= 300 && (newData.val() === '' || newData.val().matches(/^https:\\/\\//))"},
    "done":{".validate":"newData.isBoolean()"},"doneAt":{".validate":"newData.isNumber()"},
    "sent":{"$k":{".validate":"newData.isBoolean()"}},"$o":{".validate":false}}}}
}}
